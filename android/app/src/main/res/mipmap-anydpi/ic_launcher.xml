<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-25 launcher fallback. XML scales the original bitmap at draw time. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="48dp" />
            <corners android:radius="12dp" />
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item android:width="36dp" android:height="36dp" android:gravity="center">
        <bitmap android:src="@drawable/tullip_logo" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
